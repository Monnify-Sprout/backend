# Server
PORT=4000

# Supabase — managed Postgres. Service-role key: server-side ONLY, never expose.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Monnify — Sprout's own master contract (sandbox creds until go-live)
MONNIFY_API_KEY=your-monnify-api-key
MONNIFY_SECRET_KEY=your-monnify-secret-key
MONNIFY_CONTRACT_CODE=your-monnify-contract-code
MONNIFY_BASE_URL=https://sandbox.monnify.com

# BVN/NIN verification is Live Mode only per Monnify docs.
# "live" calls the real endpoint; "mock" returns deterministic responses for
# local dev and the hackathon demo (always flagged as mocked in records/logs).
MONNIFY_VERIFICATION_MODE=mock

# Auth — our own JWTs (not Supabase Auth)
JWT_SECRET=change-me-to-a-long-random-string

# Webhook signature validation
MONNIFY_WEBHOOK_SECRET=your-webhook-signing-secret

# Encryption key for connected-account Monnify credentials (32-byte hex/base64)
CREDENTIALS_ENCRYPTION_KEY=change-me-32-byte-key
